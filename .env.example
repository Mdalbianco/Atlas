# =====================================================================
# ATLAS — esempio di configurazione. Copia in `.env` (escluso da Git).
# NON inserire mai credenziali reali in questo file di esempio.
# =====================================================================

# --- Modalità ----------------------------------------------------------
# Solo "paper" è ammesso in questa versione. Qualsiasi altro valore blocca l'avvio.
ATLAS_MODE=paper
ATLAS_DATA_DIR=data
ATLAS_LOG_LEVEL=INFO
ATLAS_LOG_JSON=true

# --- Mercati -----------------------------------------------------------
ATLAS_QUOTE_CURRENCY=EUR
ATLAS_WATCHLIST=BTC/EUR,ETH/EUR,SOL/EUR
ATLAS_MARKET_REFERENCE=BTC/EUR
ATLAS_TIMEFRAME=1h
ATLAS_HIGHER_TIMEFRAME=4h
# Candele per timeframe (600-720; 720 = massimo Kraken). Servono per la convergenza dell'EMA200.
ATLAS_CANDLES_LIMIT=720

# --- Capitale e costi simulati ---------------------------------------
ATLAS_INITIAL_CAPITAL=100
ATLAS_TAKER_FEE_PCT=0.40
ATLAS_SLIPPAGE_PCT=0.05
ATLAS_DEFAULT_SPREAD_PCT=0.10
ATLAS_MIN_ORDER_COST=5

# --- Decisione ---------------------------------------------------------
ATLAS_STRATEGIES=trend_pullback,breakout
ATLAS_MIN_SCORE=65
ATLAS_MIN_REWARD_RISK=1.8

# --- Rischio -----------------------------------------------------------
ATLAS_RISK_PER_TRADE_PCT=1.0
ATLAS_MAX_POSITION_PCT=50
ATLAS_MAX_EXPOSURE_PCT=80
ATLAS_MAX_OPEN_POSITIONS=2
ATLAS_MAX_DAILY_LOSS_PCT=3
ATLAS_MAX_DRAWDOWN_PCT=15
ATLAS_MAX_CONSECUTIVE_LOSSES=4
ATLAS_COOLDOWN_HOURS=24
ATLAS_MAX_CORRELATED_RISK_PCT=1.5
ATLAS_CORRELATION_THRESHOLD=0.8
ATLAS_MAX_SPREAD_PCT=0.5

# --- Scheduler ----------------------------------------------------------
ATLAS_CYCLE_INTERVAL_SECONDS=300
ATLAS_DAILY_REPORT_HOUR_UTC=20

# --- Telegram ----------------------------------------------------------
# Token da @BotFather. Il tuo ID numerico si ottiene da @userinfobot.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Elenco di ID autorizzati (se vuoto, il bot rifiuta tutti).
TELEGRAM_ALLOWED_USERS=
# ID che possono usare /pausa, /riprendi, /chiudi, /config, watchlist add/remove.
TELEGRAM_ADMIN_USERS=

# --- Kraken (FACOLTATIVO, sola lettura) -------------------------------
# I dati di mercato sono pubblici: le chiavi servono SOLO per leggere il saldo reale.
# Crea la chiave con il SOLO permesso "Query Funds". MAI "Deposit/Withdraw" né "Create & Modify Orders".
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
